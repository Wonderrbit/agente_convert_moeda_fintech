# CambioBot Environment Configuration
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=CambioBot
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development  # development, staging, production

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cambiobot
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# =============================================================================
# REDIS (Cache & Sessions)
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# =============================================================================
# EVOLUTION API (WhatsApp Integration)
# =============================================================================
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your_evolution_api_key_here
EVOLUTION_INSTANCE_NAME=cambiobot

# =============================================================================
# LLM PROVIDERS (at least one required)
# =============================================================================
# OpenRouter (recommended - access to 100+ models)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_SITE_URL=https://github.com/Wonderrbit/agente_convert_moeda_fintech
OPENROUTER_APP_NAME=CambioBot

# OpenAI (GPT models)
OPENAI_API_KEY=

# Anthropic (Claude models)
ANTHROPIC_API_KEY=

# Google (Gemini models)
GOOGLE_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Groq (fast inference)
GROQ_API_KEY=

# xAI (Grok)
XAI_API_KEY=

# Mistral
MISTRAL_API_KEY=

# Qwen (Alibaba) - International
DASHSCOPE_API_KEY=

# GLM (Zhipu) - International
ZHIPU_API_KEY=

# MiniMax - Global
MINIMAX_API_KEY=

# Ollama (local models)
OLLAMA_BASE_URL=http://localhost:11434/v1

# =============================================================================
# LLM CONFIGURATION
# =============================================================================
# Provider: openai, anthropic, google, openrouter, deepseek, groq, xai, mistral, ollama, openai_compatible
LLM_PROVIDER=openrouter

# Model for complex reasoning (analysis, planning)
DEEP_THINK_LLM=anthropic/claude-3.5-sonnet

# Model for quick tasks (classification, extraction)
QUICK_THINK_LLM=openai/gpt-4o-mini

# Custom OpenAI-compatible endpoint (optional)
BACKEND_URL=

# Sampling temperature (0.0 = deterministic, 1.0 = creative)
TEMPERATURE=0.1

# Max output tokens
MAX_TOKENS=8192

# Max retries for LLM calls
LLM_MAX_RETRIES=3

# =============================================================================
# TRADINGAGENTS INTEGRATION
# =============================================================================
TRADINGAGENTS_ENABLED=true
TRADINGAGENTS_DEBUG=false
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_CHECKPOINT_ENABLED=false

# =============================================================================
# FX DATA PROVIDERS (optional but recommended)
# =============================================================================
# Alpha Vantage (free tier: 25 req/day, 5 req/min)
ALPHA_VANTAGE_API_KEY=

# FRED (Federal Reserve Economic Data) - free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ExchangeRate-API.com (free tier: 1500 req/month)
EXCHANGE_RATE_API_KEY=

# CurrencyAPI.com (free tier available)
CURRENCYAPI_KEY=

# =============================================================================
# OBSERVABILITY
# =============================================================================
# LangFuse (LLM observability) - get keys at https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Grafana
GRAFANA_URL=http://localhost:3000

# Prometheus
PROMETHEUS_PORT=9090

# Sentry (error tracking)
SENTRY_DSN=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json  # json, console

# =============================================================================
# AFFILIATE PARTNERS (pre-configured, override if needed)
# =============================================================================
NOMAD_AFFILIATE_URL=https://nomad.app.link/cambiobot?utm_source=cambiobot
WISE_AFFILIATE_URL=https://wise.com/invite/cambiobot
AVENUE_AFFILIATE_URL=https://avenue.us/cambiobot
WESTERN_UNION_AFFILIATE_URL=https://westernunion.com.br/cambiobot

# =============================================================================
# SECURITY
# =============================================================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ENCRYPTION_KEY=  # 32-byte base64 encoded key for field encryption
WEBHOOK_SECRET=  # Secret for verifying Evolution API webhooks

# =============================================================================
# DEVELOPMENT OVERRIDES (TRADINGAGENTS_* vars override config)
# =============================================================================
# TRADINGAGENTS_LLM_PROVIDER=openrouter
# TRADINGAGENTS_DEEP_THINK_LLM=anthropic/claude-3.5-sonnet
# TRADINGAGENTS_QUICK_THINK_LLM=openai/gpt-4o-mini
# TRADINGAGENTS_LLM_BACKEND_URL=https://openrouter.ai/api/v1
# TRADINGAGENTS_OUTPUT_LANGUAGE=Portuguese
# TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
# TRADINGAGENTS_MAX_RISK_ROUNDS=1
# TRADINGAGENTS_CHECKPOINT_ENABLED=false
# TRADINGAGENTS_TEMPERATURE=0.1
# TRADINGAGENTS_LLM_MAX_RETRIES=3
# TRADINGAGENTS_MAX_TOKENS=8192